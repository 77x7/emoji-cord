[Desktop Entry]
Name=Emoji-cord
GenericName=Emoji Input Method
Comment=System-wide colon-triggered emoji completion
Exec=emoji-cord
Icon=input-keyboard-virtual
Terminal=false
Type=Application
Categories=Utility;System;
NoDisplay=true
OnlyShowIn=KDE;
StartupNotify=false
X-KDE-StartupNotify=false
X-KDE-Wayland-VirtualKeyboard=true
